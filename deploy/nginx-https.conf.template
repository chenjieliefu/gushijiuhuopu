server {
    listen 80;
    server_name gushi.zexuan-604.com;
    location ^~ /.well-known/acme-challenge/ { root /opt/story-shop/acme; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name gushi.zexuan-604.com;
    ssl_certificate /etc/letsencrypt/live/gushi.zexuan-604.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gushi.zexuan-604.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /opt/story-shop/current/frontend/dist;
    index index.html;
    client_max_body_size 32k;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    location /api/ {
        proxy_pass http://127.0.0.1:18089;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 35s;
        add_header Cache-Control no-store always;
    }
    location = /health {
        proxy_pass http://127.0.0.1:18089;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location = /index.html { add_header Cache-Control no-cache; }
    location /assets/ { try_files $uri =404; expires 1h; }
    location /audio/ { try_files $uri =404; expires 1h; }
    location / { try_files $uri $uri/ /index.html; }
}
