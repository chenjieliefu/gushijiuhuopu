# uv run 不会自动读取本文件；启动时使用 uv run --env-file .env ...
DATABASE_PATH=data/story-shop.sqlite3
STORY_PATH=stories/demo.json
AI_MODE=mock
AI_TIMEOUT_SECONDS=10
AI_MAX_PARALLEL=4
# 正式章节离线联调：STORY_PATH=stories/lost-sunshine.json，AI_MODE=scripted
# 真实模块就绪后：AI_MODE=custom，AI_PROVIDER_FACTORY=app.your_provider:create_provider
AI_PROVIDER_FACTORY=
# 看山真实对话：AI_MODE=custom，AI_PROVIDER_FACTORY=app.story_ai:create_provider
AI_BASE_URL=https://api.openai-next.com/v1
AI_MODEL=gemini-3.8-flash
AI_API_PROTOCOL=gemini
AI_API_KEY=
# 真实模式建议 AI_TIMEOUT_SECONDS=45；可选独立配音服务，留空仍可阅读文字。
VOICE_SERVICE_URL=
# 逗号分隔，填写前端实际来源。留空只接受同源浏览器调用。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# 单实例受控试玩的运行上限。代理来源必须另行在 Uvicorn 中显式信任。
MAX_REQUEST_BYTES=16384
REQUESTS_PER_MINUTE=120
SESSION_CREATES_PER_HOUR=10
CHATS_PER_MINUTE=30
MAX_SESSIONS=1000
# 闲置 30 天失效；启动时及每小时清理过期会话和幂等历史。
SESSION_TTL_SECONDS=2592000
CLEANUP_INTERVAL_SECONDS=3600
MAX_COMMANDS_PER_SESSION=1000
MAX_DATABASE_BYTES=536870912
# UTC 日累计生成尝试（含失败及脚本模式），不是人民币/美元金额。
AI_DAILY_CALL_LIMIT=200
