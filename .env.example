# uv run 不会自动读取本文件；启动时使用 uv run --env-file .env ...
DATABASE_PATH=data/story-shop.sqlite3
STORY_PATH=stories/demo.json
AI_MODE=mock
AI_TIMEOUT_SECONDS=10
AI_MAX_PARALLEL=4
# 正式章节离线联调：STORY_PATH=stories/lost-sunshine.json，AI_MODE=scripted
# 真实模块就绪后：AI_MODE=custom，AI_PROVIDER_FACTORY=app.your_provider:create_provider
AI_PROVIDER_FACTORY=
# 逗号分隔，填写前端实际来源。留空只接受同源浏览器调用。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
